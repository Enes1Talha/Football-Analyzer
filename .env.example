# ─────────────────────────────────────────────
#  Football Data & Form Analyzer – Environment
# ─────────────────────────────────────────────
#
# 1. Copy this file to .env.local
#    cp .env.example .env.local
#
# 2. Supabase – https://supabase.com → New Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 3. (Legacy) RapidAPI – no longer used, kept for reference
# RAPIDAPI_KEY=your_rapidapi_key_here

# Default teams shown on first load
NEXT_PUBLIC_DEFAULT_TEAM_A=50
NEXT_PUBLIC_DEFAULT_TEAM_B=42
NEXT_PUBLIC_DEFAULT_LEAGUE=39
NEXT_PUBLIC_DEFAULT_SEASON=2023
