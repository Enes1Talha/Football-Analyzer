# ─────────────────────────────────────────────
#  Football Data & Form Analyzer – Environment
# ─────────────────────────────────────────────
#
# 1. Copy this file to .env.local
#    cp .env.example .env.local
#
# 2. Get your free RapidAPI key:
#    https://rapidapi.com/api-sports/api/api-football
#
# 3. Paste your key below (no quotes needed)
# ─────────────────────────────────────────────

RAPIDAPI_KEY=your_rapidapi_key_here

# Default teams shown on first load (optional — change to any team IDs from API-Football)
# Premier League examples: Man City = 50, Arsenal = 42, Liverpool = 40
NEXT_PUBLIC_DEFAULT_TEAM_A=50
NEXT_PUBLIC_DEFAULT_TEAM_B=42
NEXT_PUBLIC_DEFAULT_LEAGUE=39
NEXT_PUBLIC_DEFAULT_SEASON=2023
